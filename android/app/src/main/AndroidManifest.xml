<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission android:name="${applicationId}.permission.EMBED_DISPLAY" android:protectionLevel="signature" />

    <uses-feature
        android:name="android.hardware.usb.accessory"
        android:required="false" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Local wireless ADB pairing/connect and the CarLife transport. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Explicit first-run choice to keep the active CarLife session alive in the background. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Optional HU notification shade, enabled only after standard Android overlay consent. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />
    <uses-feature android:name="android.software.companion_device_setup" android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />
    <!-- User-confirmed installation of a verified optional desktop component. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- A connectedDevice foreground service must also be able to finish or wait when the USB grant goes away. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Inspect local interfaces to connect to this phone's adbd. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 17+: DNS-SD discovery and local TLS pairing/activation of wireless ADB. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- без queries на API 30+ пакет Android Auto не виден (проверка установки, запуск настроек) -->
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.APP_MAPS" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.APP_MUSIC" /></intent>
        <intent><action android:name="android.intent.action.ASSIST" /></intent>
        <intent><action android:name="android.intent.action.VOICE_COMMAND" /></intent>
        <package android:name="com.yandex.searchapp" />
        <package android:name="ru.yandex.searchplugin" />
        <intent>
            <action android:name="com.headswap.desk.action.DESKTOP_COMPONENT" />
            <category android:name="android.intent.category.DEFAULT" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <intent>
            <action android:name="android.intent.action.UNINSTALL_PACKAGE" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="ru.drivedeck.headswap" />
        <package android:name="com.headswap.navigator.experimental" />
        <package android:name="ru.yandex.yandexnavi" />
        <package android:name="com.sec.android.app.launcher" />
        <package android:name="com.google.android.projection.gearhead" />
        <!-- раздел «Приложения для магнитолы»: статус установки и запуск каталога (Fermata Auto, ParkedTube, AABrowser) -->
        <package android:name="me.aap.fermata.auto.dear.google.why" />
        <package android:name="dev.codex.aaparkedyoutube" />
        <package android:name="com.kododake.aabrowser" />
        <!-- поиск любых приложений для Android Auto: плееры (сервис) и полноэкранные (activity) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.CAR_LAUNCHER" />
        </intent>
    </queries>

    <!-- Explicit computer activation only. Default target process is the main app, not :delegated. -->
    <instrumentation
        android:name="com.headswap.desk.dex.DelegatedDesktopInstrumentation"
        android:targetPackage="${applicationId}"
        android:functionalTest="true"
        android:handleProfiling="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="HeadSwap Desktop"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="false"
        android:theme="@style/Theme.Headswap.Dex">

        <activity android:name=".dex.PhonePanelWakeActivity" android:exported="false"
            android:excludeFromRecents="true" android:taskAffinity="${applicationId}.phonepanel"
            android:resizeableActivity="false" android:hardwareAccelerated="true"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <activity
            android:name=".dex.DexSetupActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/accessory_filter" />
        </activity>

        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".dex.DesktopWizardActivationActivity" android:exported="false" android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden" />
        <activity android:name=".dex.DesktopOnboardingActivity" android:exported="false" />
        <activity android:name=".link.car.WirelessSetupActivity" android:exported="false" android:theme="@style/Theme.Headswap.Dex" />
        <service android:name=".dex.PhonePairingService" android:exported="false" android:foregroundServiceType="connectedDevice" />
        <receiver android:name=".link.car.CarAclReceiver" android:exported="true" android:enabled="false">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".desktop.DriveDeckFullscreenActivity"
            android:exported="true"
            android:permission="${applicationId}.permission.EMBED_DISPLAY"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:launchMode="singleTop"
            android:taskAffinity="${applicationId}.drivedeck.fullscreen"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.Headswap.Dex" />
        <activity android:name=".desktop.NotificationFullscreenActivity" android:exported="false"
            android:excludeFromRecents="true" android:resizeableActivity="true" android:launchMode="singleTop"
            android:taskAffinity="${applicationId}.notification.fullscreen"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.Headswap.Dex" />
        <activity android:name=".dex.DpiCorrectionActivity" android:exported="false" android:theme="@style/Theme.Headswap.Dex" />
        <activity android:name=".update.ComponentUpdatesActivity" android:exported="false" />
        <activity android:name=".update.ComponentPermissionsActivity" android:exported="false" />
        <provider
            android:name=".update.ComponentApkProvider"
            android:authorities="${applicationId}.components"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/component_apk_paths" />
        </provider>

        <provider
            android:name=".dex.VdmHostProvider"
            android:authorities="${applicationId}.vdmhost"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Explicitly launched by the shell service on its own display only; never a phone HOME. -->
        <activity
            android:name=".desktop.AndroidDesktopActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:excludeFromRecents="true"
            android:taskAffinity="${applicationId}.desktop"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.Headswap.Dex" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- раздача логов и отчётов через «Поделиться» (только чтение, без AndroidX FileProvider) -->
        <provider
            android:name=".ui.LogProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- кнопка «Стоп» в уведомлении -->
        <receiver
            android:name=".ui.StopReceiver"
            android:exported="false" />

        <!-- CarLife USB connection; this fork does not capture microphone audio. -->
        <service
            android:name=".BridgeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <service
            android:name=".cluster.ClusterNavigationListener"
            android:label="HeadSwap — подсказки и уведомления на магнитоле"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service
            android:name=".embed.EmbeddedDisplayService"
            android:exported="true"
            android:permission="${applicationId}.permission.EMBED_DISPLAY" />
        <service
            android:name=".dex.DelegatedDesktopService"
            android:exported="false"
            android:process=":delegated" />
    </application>
</manifest>
